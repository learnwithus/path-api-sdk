{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "paths": {
      "#app": [
        "./node_modules/nuxt/dist/app/index.d.ts"
      ],
      "#app/*": [
        "./node_modules/nuxt/dist/app/*"
      ],
      "@vch-lt/path": [
        "./src/typescript/index.ts"
      ],
      "@vch-lt/path/nuxt": [
        "./src/typescript/nuxt.ts"
      ],
      "@vch-lt/path/server": [
        "./src/typescript/server.ts"
      ]
    }
  },
  "include": [
    "src/typescript/nuxt-runtime/**/*",
    "types/nuxt-app.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
