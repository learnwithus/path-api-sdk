{
  "name": "@vch-lt/path",
  "version": "0.1.4",
  "description": "TypeScript SDK for integrating custom course websites with Path patient tracking software (VCH)",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./next": {
      "import": "./dist/next.js",
      "types": "./dist/next.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "peerDependencies": {
    "next": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "path",
    "vch",
    "learner",
    "patient-tracking",
    "healthcare",
    "training",
    "progress-tracking",
    "api",
    "sdk",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/learnwithus/path-api-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/learnwithus/path-api-sdk/issues"
  },
  "homepage": "https://github.com/learnwithus/path-api-sdk#readme",
  "author": "Learn With Us",
  "license": "ISC",
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vue": "^3.5.27"
  },
  "dependencies": {
    "cookie": "^1.1.1"
  }
}
