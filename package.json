{
  "name": "@vch-lt/path",
  "version": "0.4.0",
  "description": "TypeScript SDK for integrating custom course websites with Path patient tracking software (VCH)",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "default": "./dist/nuxt.js"
    }
  },
  "peerDependencies": {
    "h3": ">=1.0.0",
    "next": ">=13.0.0",
    "nuxt": ">=3.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly && cp -r src/nuxt-runtime dist/nuxt-runtime && node -e \"const fs=require('fs');const c='dist/next-client.js';fs.writeFileSync(c,'\\\"use client\\\";\\n'+fs.readFileSync(c,'utf8'));fs.writeFileSync('dist/next.js','export * from \\\"./next-server.js\\\";\\nexport * from \\\"./next-client.js\\\";\\n')\"",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "path",
    "vch",
    "learner",
    "patient-tracking",
    "healthcare",
    "training",
    "progress-tracking",
    "api",
    "sdk",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learnwithus/path-api-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/learnwithus/path-api-sdk/issues"
  },
  "homepage": "https://github.com/learnwithus/path-api-sdk#readme",
  "author": "Learn With Us",
  "license": "ISC",
  "devDependencies": {
    "@nuxt/kit": "^4.3.1",
    "@types/cookie": "^0.6.0",
    "@types/react": ">=18.0.0",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "h3": "^1.15.5",
    "next": "^16.1.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vue": "^3.5.27"
  },
  "dependencies": {
    "cookie": "^1.1.1"
  }
}
